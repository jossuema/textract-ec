# Copia este archivo a .env y exporta las variables (o usa: set -a; source .env; set +a).
# Perfil de ~/.aws/config y ~/.aws/credentials con permisos de Textract (ver iam/).
AWS_PROFILE=personal
# Región del laboratorio (Textract NO existe en sa-east-1). Cambiar solo ante un incidente regional.
LAB_REGION=us-east-1
# Fuerza el modo: online | offline. Sin definir, el helper decide según haya credenciales.
# LAB_MODO=offline
# Guarda del ponente: con esta variable el kit se niega a ir online con el perfil 'default' de ~/.aws.
# LAB_BLOQUEAR_DEFAULT=1
